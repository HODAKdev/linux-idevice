# 1 "arch/arm64/boot/dts/apple/s5l8960x.dtsi" 1
# 11 "arch/arm64/boot/dts/apple/s5l8960x.dtsi"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
