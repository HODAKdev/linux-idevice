  compatible = "apple,s5l8960x-pmgr-pwrstate", "apple,pmgr-pwrstate";
  reg = <0x20000 4>;
  #power-domain-cells = <0>;
  #reset-cells = <0>;
  label = "cpu0";
  apple,always-on;
 };

