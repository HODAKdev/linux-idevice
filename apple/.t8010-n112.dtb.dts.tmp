/dts-v1/;

# 1 "arch/arm64/boot/dts/apple/t8010.dtsi" 1
# 10 "arch/arm64/boot/dts/apple/t8010.dtsi"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 11 "arch/arm64/boot/dts/apple/t8010.dtsi" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/apple-aic.h" 1




# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 6 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/apple-aic.h" 2
# 12 "arch/arm64/boot/dts/apple/t8010.dtsi" 2

# 1 "./scripts/dtc/include-prefixes/dt-bindings/phy/phy.h" 1
# 14 "arch/arm64/boot/dts/apple/t8010.dtsi" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/apple.h" 1
# 15 "arch/arm64/boot/dts/apple/t8010.dtsi" 2

/ {
 interrupt-parent = <&aic>;
 #address-cells = <2>;
 #size-cells = <2>;

 clkref: clock-ref {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <24000000>;
  clock-output-names = "clkref";
 };

 cpus {
  #address-cells = <2>;
  #size-cells = <0>;

  cpu0: cpu@0 {
   compatible = "apple,hurricane-zephyr";
   reg = <0x0 0x0>;
   cpu-release-addr = <0 0>;
   operating-points-v2 = <&fusion_opp>;
   performance-domains = <&cpufreq>;
   enable-method = "spin-table";
   device_type = "cpu";
   next-level-cache = <&l2_cache>;
   i-cache-size = <0x10000>;
   d-cache-size = <0x10000>;
  };

  cpu1: cpu@1 {
   compatible = "apple,hurricane-zephyr";
   reg = <0x0 0x1>;
   cpu-release-addr = <0 0>;
   operating-points-v2 = <&fusion_opp>;
   performance-domains = <&cpufreq>;
   enable-method = "spin-table";
   device_type = "cpu";
   next-level-cache = <&l2_cache>;
   i-cache-size = <0x10000>;
   d-cache-size = <0x10000>;
  };

  l2_cache: l2-cache {
   compatible = "cache";
   cache-level = <2>;
   cache-unified;
   cache-size = <0x300000>;
  };
 };

 fusion_opp: opp-table {
  compatible = "operating-points-v2";
# 78 "arch/arm64/boot/dts/apple/t8010.dtsi"
  opp01 {
   opp-hz = /bits/ 64 <172000000>;
   opp-level = <1>;
   clock-latency-ns = <11000>;
  };
  opp02 {
   opp-hz = /bits/ 64 <230000000>;
   opp-level = <2>;
   clock-latency-ns = <49000>;
  };
  opp03 {
   opp-hz = /bits/ 64 <425000000>;
   opp-level = <3>;
   clock-latency-ns = <13000>;
  };
  opp04 {
   opp-hz = /bits/ 64 <637000000>;
   opp-level = <4>;
   clock-latency-ns = <18000>;
  };
  opp05 {
   opp-hz = /bits/ 64 <756000000>;
   opp-level = <5>;
   clock-latency-ns = <35000>;
  };
  opp06 {
   opp-hz = /bits/ 64 <1056000000>;
   opp-level = <6>;
   clock-latency-ns = <31000>;
  };
  opp07 {
   opp-hz = /bits/ 64 <1356000000>;
   opp-level = <7>;
   clock-latency-ns = <37000>;
  };
  opp08 {
   opp-hz = /bits/ 64 <1644000000>;
   opp-level = <8>;
   clock-latency-ns = <39500>;
  };
  hurricane_opp09: opp09 {
   opp-hz = /bits/ 64 <1944000000>;
   opp-level = <9>;
   clock-latency-ns = <46000>;
   status = "disabled";
  };
  hurricane_opp10: opp10 {
   opp-hz = /bits/ 64 <2244000000>;
   opp-level = <10>;
   clock-latency-ns = <56000>;
   status = "disabled";
  };
# 140 "arch/arm64/boot/dts/apple/t8010.dtsi"
 };

 soc {
  compatible = "simple-bus";
  #address-cells = <2>;
  #size-cells = <2>;
  nonposted-mmio;
  ranges;

  cpufreq: performance-controller@202f20000 {
   compatible = "apple,t8010-cluster-cpufreq", "apple,t8103-cluster-cpufreq", "apple,cluster-cpufreq";
   reg = <0x2 0x02f20000 0 0x1000>;
   #performance-domain-cells = <0>;
  };

  serial0: serial@20a0c0000 {
   compatible = "apple,s5l-uart";
   reg = <0x2 0x0a0c0000 0x0 0x4000>;
   reg-io-width = <4>;
   interrupt-parent = <&aic>;
   interrupts = <0 218 4>;

   clocks = <&clkref>, <&clkref>;
   clock-names = "uart", "clk_uart_baud0";
   power-domains = <&ps_uart0>;
   status = "disabled";
  };

  i2c0: i2c@20a110000 {
   compatible = "apple,t8010-i2c", "apple,i2c";
   reg = <0x2 0x0a110000 0x0 0x1000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 232 4>;
   pinctrl-0 = <&i2c0_pins>;
   pinctrl-names = "default";
   power-domains = <&ps_i2c0>;
   #address-cells = <1>;
   #size-cells = <0>;
   status = "disabled";
  };

  i2c1: i2c@20a111000 {
   compatible = "apple,t8010-i2c", "apple,i2c";
   reg = <0x2 0x0a111000 0x0 0x1000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 233 4>;
   pinctrl-0 = <&i2c1_pins>;
   pinctrl-names = "default";
   power-domains = <&ps_i2c1>;
   #address-cells = <1>;
   #size-cells = <0>;
   status = "disabled";
  };

  i2c2: i2c@20a112000 {
   compatible = "apple,t8010-i2c", "apple,i2c";
   reg = <0x2 0x0a112000 0x0 0x1000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 234 4>;
   pinctrl-0 = <&i2c2_pins>;
   pinctrl-names = "default";
   power-domains = <&ps_i2c2>;
   #address-cells = <1>;
   #size-cells = <0>;
   status = "disabled";
  };

  i2c3: i2c@20a113000 {
   compatible = "apple,t8010-i2c", "apple,i2c";
   reg = <0x2 0x0a113000 0x0 0x1000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 235 4>;
   pinctrl-0 = <&i2c3_pins>;
   pinctrl-names = "default";
   power-domains = <&ps_i2c3>;
   #address-cells = <1>;
   #size-cells = <0>;
   status = "disabled";
  };

  bus@20c000000 {
   compatible = "apple,t8010-usb-complex", "apple,s5l8960x-usb-complex", "simple-pm-bus";
   #address-cells = <2>;
   #size-cells = <2>;
   dma-ranges = <0x0 0x00000000 0x8 0x00000000 0x1 0x00000000>;
   nonposted-mmio;
   ranges;

   reg = <0x2 0x0c900000 0x0 0x100>;
   power-domains = <&ps_usb>;

   ausbphy0: phy@20c000030 {
    compatible = "apple,t8010-ausb-phy", "apple,ausb-phy";
    reg = <0x2 0x0c000030 0x0 0x20>;
    power-domains = <&ps_usbctrl>;
    #phy-cells = <1>;

   };

   usbdev: usbdev@20c100000 {
    compatible = "apple,t8010-dwc2", "apple,dwc2";
    reg = <0x2 0x0c100000 0x0 0x10000>;
    interrupts = <0 241 4>;
    clocks = <&clkref>;
    clock-names = "otg";
    phys = <&ausbphy0 3>;
    phy-names = "usb2-phy";
    power-domains = <&ps_usbotg>;
    resets = <&ps_usbotg>;
    dr_mode = "peripheral";
   };
# 277 "arch/arm64/boot/dts/apple/t8010.dtsi"
  };

  pmgr: power-management@20e000000 {
   compatible = "apple,t8010-pmgr", "apple,pmgr", "syscon", "simple-mfd";
   #address-cells = <1>;
   #size-cells = <1>;

   reg = <0x2 0xe000000 0 0x8c000>;
  };

  aic: interrupt-controller@20e100000 {
   compatible = "apple,t8010-aic", "apple,aic";
   reg = <0x2 0x0e100000 0x0 0x100000>;
   #interrupt-cells = <3>;
   interrupt-controller;
   power-domains = <&ps_aic>;
  };

  dwi_bl: backlight@20e200080 {
   compatible = "apple,t8010-dwi-bl", "apple,dwi-bl";
   reg = <0x2 0x0e200080 0x0 0x8>;
   power-domains = <&ps_dwi>;
   status = "disabled";
  };

  pinctrl_ap: pinctrl@20f100000 {
   compatible = "apple,t8010-pinctrl", "apple,pinctrl";
   reg = <0x2 0x0f100000 0x0 0x100000>;
   power-domains = <&ps_gpio>;

   gpio-controller;
   #gpio-cells = <2>;
   gpio-ranges = <&pinctrl_ap 0 0 208>;
   apple,npins = <208>;

   interrupt-controller;
   #interrupt-cells = <2>;
   interrupt-parent = <&aic>;
   interrupts = <0 42 4>,
         <0 43 4>,
         <0 44 4>,
         <0 45 4>,
         <0 46 4>,
         <0 47 4>,
         <0 48 4>;

   i2c0_pins: i2c0-pins {
    pinmux = <((197) | ((1) << 16))>,
      <((196) | ((1) << 16))>;
   };

   i2c1_pins: i2c1-pins {
    pinmux = <((40) | ((1) << 16))>,
      <((39) | ((1) << 16))>;
   };

   i2c2_pins: i2c2-pins {
    pinmux = <((132) | ((1) << 16))>,
      <((133) | ((1) << 16))>;
   };

   i2c3_pins: i2c3-pins {
    pinmux = <((41) | ((1) << 16))>,
      <((42) | ((1) << 16))>;
   };
  };

  pinctrl_aop: pinctrl@2100f0000 {
   compatible = "apple,t8010-pinctrl", "apple,pinctrl";
   reg = <0x2 0x100f0000 0x0 0x100000>;
   power-domains = <&ps_aop_gpio>;

   gpio-controller;
   #gpio-cells = <2>;
   gpio-ranges = <&pinctrl_aop 0 0 42>;
   apple,npins = <42>;

   interrupt-controller;
   #interrupt-cells = <2>;
   interrupt-parent = <&aic>;
   interrupts = <0 128 4>,
         <0 129 4>,
         <0 130 4>,
         <0 131 4>,
         <0 132 4>,
         <0 133 4>,
         <0 134 4>;
  };

  pmgr_mini: power-management@210200000 {
   compatible = "apple,t8010-pmgr", "apple,pmgr", "syscon", "simple-mfd";
   #address-cells = <1>;
   #size-cells = <1>;

   reg = <0x2 0x10200000 0 0x84000>;
  };

  wdt: watchdog@2102b0000 {
   compatible = "apple,t8010-wdt", "apple,wdt";
   reg = <0x2 0x102b0000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 4 4>;
  };
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupt-parent = <&aic>;
  interrupt-names = "phys", "virt";

  interrupts = <1 2 4>,
        <1 3 4>;
 };

 pmu {
  compatible = "apple,fusion-pmu";
  interrupt-parent = <&aic>;
  interrupts = <0 83 4>,
        <0 86 4>;
  interrupt-affinity = <&cpu0 &cpu1>;
 };
};

# 1 "arch/arm64/boot/dts/apple/t8010-pmgr.dtsi" 1







&pmgr {
 ps_cpu0: power-controller@80000 {
  compatible = "apple,t8010-pmgr-pwrstate", "apple,pmgr-pwrstate";
  reg = <0x80000 4>;
  #power-domain-cells = <0>;
  #reset-cells = <0>;
  label = "cpu0";
  apple,always-on;
 };

 ps_cpu1: power-controller@80008 {
  compatible = "apple,t8010-pmgr-pwrstate", "apple,pmgr-pwrstate";
  reg = <0x80008 4>;
  #power-domain-cells = <0>;
  #reset-cells = <0>;
