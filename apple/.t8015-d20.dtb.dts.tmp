# 725 "arch/arm64/boot/dts/apple/t8015.dtsi" 2
# 9 "arch/arm64/boot/dts/apple/t8015-8.dtsi" 2
# 1 "arch/arm64/boot/dts/apple/t8015-common.dtsi" 1
# 12 "arch/arm64/boot/dts/apple/t8015-common.dtsi"
/ {
 aliases {
  ausbphy0 = &ausbphy0;
  serial0 = &serial0;

  smc = &smc;
 };

 chosen {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  stdout-path = "serial0";

  framebuffer0: framebuffer@0 {
   compatible = "apple,simple-framebuffer", "simple-framebuffer";
   reg = <0 0 0 0>;
   power-domains = <&ps_disp0_be &ps_mipi_dsi &ps_disp0_hilo &ps_disp0_ppp>;

   status = "disabled";
  };
 };

 memory@800000000 {
  device_type = "memory";
  reg = <0x8 0 0 0>;
 };

 reserved-memory {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;


 };
};

&serial0 {
 status = "okay";
};

&smc_hwmon {
 temperature-TG0B {
  apple,key-id = "TG0B";
  label = "Battery Temp";
 };

 temperature-TG0V {
  apple,key-id = "TG0V";
  label = "Battery Flex Temp";
 };

 temperature-TP1d {
  apple,key-id = "TP1d";
  label = "Forehead Temp";
 };

 temperature-TP2d {
  apple,key-id = "TP2d";
  label = "Rear Camera Temp";
 };

 temperature-TP3d {
  apple,key-id = "TP3d";
  label = "Cellular Radio Temp";
 };

 temperature-TP4d {
  apple,key-id = "TP4d";
  label = "AP SoC Temp";
 };

 temperature-TP5d {
  apple,key-id = "TP5d";
  label = "Charger Temp";
 };
};
# 10 "arch/arm64/boot/dts/apple/t8015-8.dtsi" 2

/ {
 chassis-type = "handset";
};

&dwi_bl {
 status = "okay";
};
# 10 "arch/arm64/boot/dts/apple/t8015-d20.dts" 2

/ {
 compatible = "apple,d20", "apple,t8015", "apple,arm-platform";
 model = "Apple iPhone 8 (Global)";
};
