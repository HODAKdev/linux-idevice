# 445 "arch/arm64/boot/dts/apple/t8122.dtsi" 2
# 13 "arch/arm64/boot/dts/apple/t8122-j615.dts" 2
# 1 "arch/arm64/boot/dts/apple/t8122-jxxx.dtsi" 1
# 12 "arch/arm64/boot/dts/apple/t8122-jxxx.dtsi"
/ {
 aliases {
  serial0 = &serial0;
 };

 chosen {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  stdout-path = "serial0";

  framebuffer0: framebuffer@0 {
   compatible = "apple,simple-framebuffer", "simple-framebuffer";
   reg = <0 0 0 0>;
   power-domains = <&ps_disp_cpu>, <&ps_dptx_ext_phy>;

   status = "disabled";
  };
 };

 reserved-memory {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

 };

 memory@800000000 {
  device_type = "memory";
  reg = <0x8 0 0x2 0>;
 };
};

&serial0 {
 status = "okay";
};
# 14 "arch/arm64/boot/dts/apple/t8122-j615.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/leds/common.h" 1
# 15 "arch/arm64/boot/dts/apple/t8122-j615.dts" 2

/ {
 compatible = "apple,j615", "apple,t8122", "apple,arm-platform";
 model = "Apple MacBook Air (15-inch, M3, 2024)";

 led-controller {
  compatible = "pwm-leds";
  led-0 {
   pwms = <&fpwm1 0 40000>;
   label = "kbd_backlight";
   function = "kbd_backlight";
   color = <0>;
   max-brightness = <255>;
   default-state = "keep";
  };
 };
};

&fpwm1 {
 status = "okay";
};
