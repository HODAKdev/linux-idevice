 };

 ps_mca0: power-controller@20130 {
  compatible = "apple,t7000-pmgr-pwrstate", "apple,pmgr-pwrstate";
  reg = <0x20130 4>;
  #power-domain-cells = <0>;
  #reset-cells = <0>;
  label = "mca0";
  power-domains = <&ps_sio_p>;
 };

 ps_mca1: power-controller@20138 {
  compatible = "apple,t7000-pmgr-pwrstate", "apple,pmgr-pwrstate";
  reg = <0x20138 4>;
  #power-domain-cells = <0>;
  #reset-cells = <0>;
