# 359 "arch/arm64/boot/dts/apple/t7000.dtsi" 2
# 10 "arch/arm64/boot/dts/apple/t7000-j42d.dts" 2
# 1 "arch/arm64/boot/dts/apple/t7000-common.dtsi" 1
# 12 "arch/arm64/boot/dts/apple/t7000-common.dtsi"
/ {
 aliases {
  ausbphy0 = &ausbphy0;
  serial0 = &serial0;
  serial6 = &serial6;
 };

 chosen {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;
 };

 memory@800000000 {
  device_type = "memory";
  reg = <0x8 0 0 0>;
 };

 reserved-memory {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;


 };
};
# 11 "arch/arm64/boot/dts/apple/t7000-j42d.dts" 2

/ {
 compatible = "apple,j42d", "apple,t7000", "apple,arm-platform";
 model = "Apple TV HD";
 chassis-type = "television";

 chosen {
  stdout-path = "serial6";

  framebuffer0: framebuffer@0 {
   compatible = "apple,simple-framebuffer", "simple-framebuffer";
   reg = <0 0 0 0>;
   power-domains = <&ps_disp0 &ps_dp>;

   status = "disabled";
  };
 };
};

&serial6 {
 status = "okay";
};

&typhoon_opp06 {
 status = "okay";
};

&i2c0 {
 status = "okay";

 pmic@74 {
  compatible = "apple,adi-pmic", "apple,i2c-pmic";
  reg = <0x74>;
  #address-cells = <1>;
  #size-cells = <1>;

  rtc@5c0 {
   compatible = "apple,adi-pmic-rtc", "apple,amber-pmic-rtc";
   reg = <0x5c0 0x10>;
   nvmem-cells = <&rtc_offset>;
   nvmem-cell-names = "rtc_offset";
  };

  nvmem@4000 {
   compatible = "apple,pmic-nvmem";
   reg = <0x4000 0x28>;

   nvmem-layout {
    compatible = "fixed-layout";
    #address-cells = <1>;
    #size-cells = <1>;

    rtc_offset: rtc-offset@4 {
     reg = <0x4 0x4>;
    };
   };
  };
 };
};
