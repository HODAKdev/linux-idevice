# 1288 "arch/arm64/boot/dts/apple/t8112.dtsi" 2
# 13 "arch/arm64/boot/dts/apple/t8112-j413.dts" 2
# 1 "arch/arm64/boot/dts/apple/t8112-jxxx.dtsi" 1
# 12 "arch/arm64/boot/dts/apple/t8112-jxxx.dtsi"
/ {
 aliases {
  atcphy0 = &atcphy0;
  atcphy1 = &atcphy1;
  serial0 = &serial0;
  serial2 = &serial2;
 };

 chosen {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  stdout-path = "serial0";

  framebuffer0: framebuffer@0 {
   compatible = "apple,simple-framebuffer", "simple-framebuffer";
   reg = <0 0 0 0>;

   status = "disabled";
  };
 };

 memory@800000000 {
  device_type = "memory";
  reg = <0x8 0 0x2 0>;
 };
};

&serial0 {
 status = "okay";
};

&serial2 {
 status = "okay";
};

&i2c0 {
 status = "okay";

 hpm0: usb-pd@38 {
  compatible = "apple,cd321x";
  reg = <0x38>;
  interrupt-parent = <&pinctrl_ap>;
  interrupts = <8 8>;
  interrupt-names = "irq";

  typec0: connector {
   compatible = "usb-c-connector";
   power-role = "dual";
   data-role = "dual";

   ports {
    #address-cells = <1>;
    #size-cells = <0>;
    port@0 {
     reg = <0>;
     typec0_connector_hs: endpoint {
      remote-endpoint = <&dwc3_0_hs>;
     };
    };
    port@1 {
     reg = <1>;
     typec0_connector_ss: endpoint {
      remote-endpoint = <&atcphy0_typec_lanes>;
     };
    };
   };
  };
 };

 hpm1: usb-pd@3f {
  compatible = "apple,cd321x";
  reg = <0x3f>;
  interrupt-parent = <&pinctrl_ap>;
  interrupts = <8 8>;
  interrupt-names = "irq";

  typec1: connector {
   compatible = "usb-c-connector";
   power-role = "dual";
   data-role = "dual";

   ports {
    #address-cells = <1>;
    #size-cells = <0>;
    port@0 {
     reg = <0>;
     typec1_connector_hs: endpoint {
      remote-endpoint = <&dwc3_1_hs>;
     };
    };
    port@1 {
     reg = <1>;
     typec1_connector_ss: endpoint {
      remote-endpoint = <&atcphy1_typec_lanes>;
     };
    };
   };
  };
 };
};


&dwc3_0 {
 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@0 {
   reg = <0>;
   dwc3_0_hs: endpoint {
    remote-endpoint = <&typec0_connector_hs>;
   };
  };

  port@1 {
   reg = <1>;
   dwc3_0_ss: endpoint {
    remote-endpoint = <&atcphy0_usb3>;
   };
  };
 };
};

&dwc3_1 {
 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@0 {
   reg = <0>;
   dwc3_1_hs: endpoint {
    remote-endpoint = <&typec1_connector_hs>;
   };
  };

  port@1 {
   reg = <1>;
   dwc3_1_ss: endpoint {
    remote-endpoint = <&atcphy1_usb3>;
   };
  };
 };
};


&atcphy0 {
 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@0 {
   reg = <0>;
   atcphy0_typec_lanes: endpoint {
    remote-endpoint = <&typec0_connector_ss>;
   };
  };

  port@1 {
   reg = <1>;
   atcphy0_usb3: endpoint {
    remote-endpoint = <&dwc3_0_ss>;
   };
  };
 };
};

&atcphy1 {
 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@0 {
   reg = <0>;
   atcphy1_typec_lanes: endpoint {
    remote-endpoint = <&typec1_connector_ss>;
   };
  };

  port@1 {
   reg = <1>;
   atcphy1_usb3: endpoint {
    remote-endpoint = <&dwc3_1_ss>;
   };
  };
 };
};

&i2c1 {
 status = "okay";
};

&i2c2 {
 status = "okay";
};

&i2c3 {
 status = "okay";
};

&nco_clkref {
 clock-frequency = <900000000>;
};

# 1 "arch/arm64/boot/dts/apple/spi1-nvram.dtsi" 1
# 10 "arch/arm64/boot/dts/apple/spi1-nvram.dtsi"
/ {
 aliases {
  nvram = &nvram;
 };
};

&spi1 {
 status = "okay";

 flash@0 {
  compatible = "jedec,spi-nor";
  reg = <0x0>;
  spi-max-frequency = <25000000>;

  partitions {
   compatible = "fixed-partitions";
   #address-cells = <1>;
   #size-cells = <1>;

   nvram: partition@700000 {
    label = "nvram";

    reg = <0x0 0x0>;
    status = "disabled";
   };
  };
 };
};
# 218 "arch/arm64/boot/dts/apple/t8112-jxxx.dtsi" 2
# 14 "arch/arm64/boot/dts/apple/t8112-j413.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/leds/common.h" 1
# 15 "arch/arm64/boot/dts/apple/t8112-j413.dts" 2

/ {
 compatible = "apple,j413", "apple,t8112", "apple,arm-platform";
 model = "Apple MacBook Air (13-inch, M2, 2022)";
 chassis-type = "laptop";

 aliases {
  bluetooth0 = &bluetooth0;
  wifi0 = &wifi0;
 };

 led-controller {
  compatible = "pwm-leds";
  led-0 {
   pwms = <&fpwm1 0 40000>;
   label = "kbd_backlight";
   function = "kbd_backlight";
   color = <0>;
   max-brightness = <255>;
   default-state = "keep";
  };
 };
};






&port00 {
 bus-range = <1 1>;
 wifi0: wifi@0,0 {
  compatible = "pci14e4,4433";
  reg = <0x10000 0x0 0x0 0x0 0x0>;

  local-mac-address = [00 10 18 00 00 10];
  apple,antenna-sku = "XX";
  brcm,board-type = "apple,hokkaido";
 };

 bluetooth0: bluetooth@0,1 {
  compatible = "pci14e4,5f71";
  reg = <0x10100 0x0 0x0 0x0 0x0>;

  local-bd-address = [00 00 00 00 00 00];
  brcm,board-type = "apple,hokkaido";
 };
};





&typec0 {
 label = "USB-C Left-back";
};

&typec1 {
 label = "USB-C Left-front";
};

&i2c0 {

 hpm5: usb-pd@3a {
  compatible = "apple,cd321x";
  reg = <0x3a>;
  interrupt-parent = <&pinctrl_ap>;
  interrupts = <8 8>;
  interrupt-names = "irq";
 };
};

&i2c4 {
 status = "okay";
};

&fpwm1 {
 status = "okay";
};
